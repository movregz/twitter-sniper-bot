# ── Twitter Sniper — configuration template ──────────────────────────────
# Copy to your environment / systemd unit / .env loader. Never commit
# real values to a public repository.

# Twitter session cookies (required)
# Export from your logged-in browser: auth_token and ct0 cookies for x.com
TWITTER_AUTH_TOKEN=your_twitter_auth_token_here
TWITTER_CT0=your_twitter_ct0_cookie_here

# Telegram delivery (required)
# Bot token from @BotFather; chat_id = your numeric Telegram chat ID
TELEGRAM_BOT_TOKEN=1234567890:your_bot_token_here
TELEGRAM_CHAT_ID=123456789

# ── Optional sniper tunables (defaults shown) ───────────────────────────
# Poll cadence: 9.0s base ± 0.5s jitter — empirically fits Twitter's
# ~100-search/15-min quota with headroom. Lower values WILL trip 429s.
SNIPER_POLL=9.0
SNIPER_POLL_JITTER=0.5

# Worker count for concurrent oracle validation
SNIPER_WORKERS=12

# Per-link oracle timeout / retries
SNIPER_LINK_TIMEOUT=2
SNIPER_LINK_RETRIES=2

# Cloudflare challenge-wall pause (seconds) after 3 straight 403s
SNIPER_CF_PAUSE=20

# Max requeue attempts for retryable failures (rate_limit/transient)
SNIPER_MAX_REQUEUE=40

# Log size cap before in-place rotation
SNIPER_LOG_MAX_BYTES=5242880

# Campaign denylist — comma-separated campaign IDs whose is_valid:true is
# a false positive (no per-link use tracking)
SNIPER_CAMPAIGN_DENYLIST=claude_invite_contest

# Dry-run mode: log sends, make no Telegram HTTP calls
# SNIPER_DRY_RUN=1
